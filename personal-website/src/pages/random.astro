        <div class="flex items-baseline justify-between border-b border-surface/60 pb-2">
          <div class="flex items-baseline space-x-1">
            <h3 class="font-serif text-lg font-medium text-primary">Food</h3>
            <a href="#fn-2" class="text-accent font-mono text-[11px] hover:underline">[2]</a>
          </div>
          <span class="font-mono text-[10px] text-muted uppercase tracking-wider"></span>
        </div>

        <div class="pt-3 pb-2">
          <div class="flex items-end justify-start gap-4 sm:gap-6 overflow-x-auto pb-0 px-2 select-none scrollbar-none">
            {topRestaurants.map((spot, idx) => (
              <div 
                class="group relative flex-shrink-0 transition-all duration-300 hover:-translate-y-2.5 cursor-default"
              >
                <div class="w-24 sm:w-28 h-36 sm:h-40 bg-[#FAF8F5] border border-[#D5CCC0] rounded-[2px] p-3 flex flex-col justify-between shadow-sm group-hover:shadow-md transition-shadow relative">
                  <div class="border-b border-dashed border-[#D5CCC0]/80 pb-1 flex items-center justify-between">
                    <span class="font-mono text-[8px] text-accent font-semibold uppercase tracking-wider">{spot.city}</span>
                    <span class="font-mono text-[8px] text-muted">no. 0{idx + 1}</span>
                  </div>
                  <p class="font-serif text-xs font-semibold text-primary leading-tight line-clamp-3 my-auto">
                    {spot.name}
                  </p>
                  <div class="border-t border-[#D5CCC0]/60 pt-1 flex items-baseline justify-between">
                    <span class="font-mono text-[8px] text-muted line-clamp-1">{spot.tag}</span>
                    <span class="font-mono text-[9px] font-semibold text-accent">{spot.rating}</span>
                  </div>

                  <div class="absolute inset-0 bg-[#2B2826]/90 text-[#FAF8F5] p-3 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between z-20 pointer-events-none rounded-[2px]">
                    <span class="font-mono text-[8px] text-accent uppercase tracking-widest">{spot.city} · {spot.tag}</span>
                    <p class="font-serif text-xs font-medium leading-snug">{spot.name}</p>
                    <div class="font-mono text-[9px] text-accent font-semibold text-right">
                      Score: {spot.rating} / 10
