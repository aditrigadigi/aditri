                  </div>
                </div>
                <span class="block text-center font-mono text-[9px] text-muted group-hover:text-accent group-hover:text-[#B4383B] transition-colors mt-2">
                  0{idx + 1}
                </span>
              </div>
            ))}
          </div>
          <div class="h-1.5 bg-[#DDD5CA] border-t border-b border-[#CBC1B4] rounded-[1px] mt-2"></div>
          <div class="h-3 bg-gradient-to-b from-[#DDD5CA]/40 to-transparent"></div>
        </div>
      </div>

    </section>

    <!-- ==========================================
         SECTION 02: LATEST
         ========================================== -->
    <section class="space-y-4">
      <div class="flex items-baseline justify-between border-b border-surface pb-3">
        <div class="flex items-baseline space-x-2">
          <h2 class="font-serif text-2xl font-semibold text-primary">Latest</h2>
          <span class="text-accent font-mono text-sm">/ 02</span>
        </div>
        <span class="font-mono text-[10px] text-muted uppercase tracking-wider"></span>
      </div>

      <div class="pt-4 pb-2">
        <div class="flex items-end justify-start gap-6 overflow-x-auto pb-0 px-2 select-none scrollbar-none">
          
          <!-- CURRENT / LATEST BOOK -->
          {mostRecentBook && (
            <a 
              href={mostRecentBook.link} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group relative flex-shrink-0 transition-all duration-300 hover:-translate-y-2.5 focus:outline-none"
            >
              <div class="relative w-28 sm:w-32 h-44 sm:h-48 bg-[#EDE7DF] rounded-[2px] shadow-sm group-hover:shadow-md border border-[#D5CCC0] overflow-hidden transition-shadow">
                <div class="absolute inset-y-0 left-0 w-2.5 bg-gradient-to-r from-black/15 via-black/5 to-transparent z-10 pointer-events-none"></div>
                {mostRecentBook.imageUrl ? (
                  <img src={mostRecentBook.imageUrl} alt={mostRecentBook.title} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <div class="p-3 h-full flex flex-col justify-between font-serif">
                    <span class="text-[9px] font-mono text-accent">{currentlyReading ? "CURRENT" : "LATEST"}</span>
                    <p class="text-[11px] leading-tight text-primary font-medium line-clamp-3">{mostRecentBook.title}</p>
                    <span class="text-[9px] font-mono text-muted">{mostRecentBook.ratingDisplay}</span>
                  </div>
                )}
                <div class="absolute inset-0 bg-[#2B2826]/90 text-[#FAF8F5] p-3 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between z-20 pointer-events-none">
                  <span class="font-mono text-[8px] text-accent uppercase tracking-widest">{currentlyReading ? "Reading Now" : "Latest Book"}</span>
                  <p class="font-serif text-xs font-medium leading-tight line-clamp-3">{mostRecentBook.title}</p>
                  <p class="font-mono text-[9px] text-[#FAF8F5]/80">{mostRecentBook.creatorOrLocation}</p>
                </div>
              </div>
              <span class="block text-center font-mono text-[9px] text-muted group-hover:text-accent group-hover:text-[#B4383B] transition-colors mt-2">
                currently reading
              </span>
            </a>
          )}

          <!-- LAST WATCHED FILM -->
          {mostRecentFilm && (
            <a 
              href={mostRecentFilm.link} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group relative flex-shrink-0 transition-all duration-300 hover:-translate-y-2.5 focus:outline-none"
            >
              <div class="relative w-28 sm:w-32 h-44 sm:h-48 bg-[#EDE7DF] rounded-[2px] shadow-sm group-hover:shadow-md border border-[#D5CCC0] overflow-hidden transition-shadow">
                {mostRecentFilm.imageUrl ? (
                  <img src={mostRecentFilm.imageUrl} alt={mostRecentFilm.title} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <div class="p-3 h-full flex flex-col justify-between font-serif">
                    <span class="text-[9px] font-mono text-accent">LAST WATCHED</span>
                    <p class="text-[11px] leading-tight text-primary font-medium line-clamp-3">{mostRecentFilm.title}</p>
                    <span class="text-[9px] font-mono text-muted">{mostRecentFilm.ratingDisplay}</span>
                  </div>
                )}
                <div class="absolute inset-0 bg-[#2B2826]/90 text-[#FAF8F5] p-3 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between z-20 pointer-events-none">
                  <span class="font-mono text-[8px] text-accent uppercase tracking-widest">Last Watched</span>
                  <p class="font-serif text-xs font-medium leading-tight line-clamp-3">{mostRecentFilm.title}</p>
                  <div class="flex items-baseline justify-between font-mono text-[9px]">
                    <span class="text-[#FAF8F5]/80">{mostRecentFilm.creatorOrLocation || "Film"}</span>
                    <span class="text-accent">{mostRecentFilm.ratingDisplay}</span>
                  </div>
                </div>
              </div>
              <span class="block text-center font-mono text-[9px] text-muted group-hover:text-accent group-hover:text-[#B4383B] transition-colors mt-2">
                last watched
              </span>
            </a>
          )}

          <!-- LAST ATE RESTAURANT -->
          {mostRecentRestaurant && (
            <div class="group relative flex-shrink-0 transition-all duration-300 hover:-translate-y-2.5 cursor-default">
              <div class="w-24 sm:w-28 h-36 sm:h-40 bg-[#FAF8F5] border border-[#D5CCC0] rounded-[2px] p-3 flex flex-col justify-between shadow-sm group-hover:shadow-md transition-shadow relative">
                <div class="border-b border-dashed border-[#D5CCC0]/80 pb-1 flex items-center justify-between">
                  <span class="font-mono text-[8px] text-accent font-semibold uppercase tracking-wider">{mostRecentRestaurant.city}</span>
                  <span class="font-mono text-[8px] text-muted">latest</span>
                </div>
                <p class="font-serif text-xs font-semibold text-primary leading-tight line-clamp-3 my-auto">
                  {mostRecentRestaurant.name}
                </p>
                <div class="border-t border-[#D5CCC0]/60 pt-1 flex items-baseline justify-between">
                  <span class="font-mono text-[8px] text-muted truncate">{mostRecentRestaurant.tag}</span>
                  <span class="font-mono text-[9px] font-semibold text-accent">{mostRecentRestaurant.rating}</span>
                </div>
              </div>
              <span class="block text-center font-mono text-[9px] text-muted group-hover:text-accent group-hover:text-[#B4383B] transition-colors mt-2">
                last ate
              </span>
            </div>
          )}

        </div>

        <!-- Shelf Plank -->
        <div class="h-1.5 bg-[#DDD5CA] border-t border-b border-[#CBC1B4] rounded-[1px] mt-2"></div>
        <div class="h-3 bg-gradient-to-b from-[#DDD5CA]/40 to-transparent"></div>
      </div>
    </section>

    {/* ==========================================
        SECTION 03: PLACES (COMMENTED OUT FOR NOW)
        ==========================================
    <section class="space-y-4">
      <div class="flex items-baseline space-x-2 border-b border-surface pb-3">
        <h2 class="font-serif text-2xl font-semibold text-primary">Places</h2>
        <span class="text-accent font-mono text-sm">/ 03</span>
      </div>

      <TravelMap places={travelData.places || shelfData.places || []} />
    </section>
    */}

    <!-- ==========================================
         SECTION 03: STREAKS & PURSUITS (MANILA ARCHIVE FOLDERS)
         ========================================== -->
    <section class="space-y-4">
      <div class="flex items-baseline justify-between border-b border-surface pb-3">
        <div class="flex items-baseline space-x-2">
          <h2 class="font-serif text-2xl font-semibold text-primary">Others</h2>
          <span class="text-accent font-mono text-sm">/ 03</span>
        </div>
        <span class="font-mono text-[10px] text-muted uppercase tracking-wider"></span>
      </div>

      <!-- File Folder Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
        {(shelfData.games || []).map((game, idx) => (
          <div class="group relative bg-[#F5EFEB] border border-[#D8CFC4] rounded-t-sm rounded-b-md p-4 pt-3 shadow-sm hover:shadow-md transition-all duration-200 hover:-translate-y-1">
            <div class="absolute -top-3 left-3 bg-[#E8DEC8] border-t border-l border-r border-[#D8CFC4] px-2.5 py-0.5 rounded-t font-mono text-[8px] text-[#7A6A53] tracking-widest uppercase">
              -----
            </div>

            <div class="flex items-baseline justify-between border-b border-dashed border-[#D8CFC4] pb-2 pt-1">
              <h3 class="font-serif text-sm font-semibold text-primary group-hover:text-accent group-hover:text-[#B4383B] transition-colors">
                {game.name}
              </h3>
              <span class="font-mono text-[9px] text-[#A6998A] uppercase">Active</span>
            </div>

            <div class="mt-3 flex items-baseline justify-between">
              <div>
                <span class="font-mono text-[8px] text-muted uppercase tracking-wider block">Current</span>
                <span class="font-mono text-lg font-bold text-accent">{game.streak}</span>
              </div>
              <div class="text-right">
                <span class="font-mono text-[8px] text-muted uppercase tracking-wider block">Best Record</span>
                <span class="font-mono text-xs text-primary font-medium">{game.best}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FOOTNOTES -->
    <section class="pt-8 border-t border-surface/70 space-y-2 text-xs font-sans text-muted">
      <p id="fn-1">
        <span class="font-mono text-accent text-[11px] mr-1">[1]</span>
        <span class="italic">Latest books and films are pulled from Goodreads and Letterboxd RSS feeds; favorites, foods, music, streaks are pulled from JSON files with exported Beli data and manual lists.</span>
      </p>
      <p id="fn-2">
        <span class="font-mono text-accent text-[11px] mr-1">[2]</span>
        <span class="italic">Thanks Anushka for taking me to literally all of these</span>
      </p>
    </section>

  </div>
</BaseLayout>