---
import BaseLayout from '../layouts/BaseLayout.astro';
import TravelMap from '../components/TravelMap.astro';
import { XMLParser } from 'fast-xml-parser';
import shelfData from '../data/shelf.json';
import travelData from '../data/travel.json';

// ==========================================
// 1. CONFIGURATION & TYPES
// ==========================================
const LETTERBOXD_USER = "aditrigadigi"; 
const GOODREADS_USER_ID = "204504937"; 

interface ShelfEntry {
  title: string;
  creatorOrLocation?: string;
  ratingValue: number;
  ratingDisplay: string;
  link: string;
  imageUrl?: string;
  pubDate?: Date;
  isFavorite?: boolean;
}

const topFilms: ShelfEntry[] = [
  {
    title: "Inception",
    creatorOrLocation: "2010",
    ratingValue: 5,
    ratingDisplay: "★★★★★",
    link: "https://letterboxd.com/aditrigadigi/inception/",
    imageUrl: "https://a.ltrbxd.com/resized/sm/upload/sv/95/s9/4j/inception-0-2000-0-3000-crop.jpg?v=30d7224316",
    isFavorite: true
  },
  {
    title: "Everything Everywhere All at Once",
    creatorOrLocation: "2022",
    ratingValue: 5,
    ratingDisplay: "★★★★★",
    link: "https://letterboxd.com/aditrigadigi/everything-everywhere-all-at-once/",
    imageUrl: "https://a.ltrbxd.com/resized/film-poster/4/7/4/4/7/4/474474-everything-everywhere-all-at-once-0-2000-0-3000-crop.jpg?v=281f1a041e",
    isFavorite: true
  },
  {
    title: "Knives Out",
    creatorOrLocation: "2019",
    ratingValue: 5,
    ratingDisplay: "★★★★★",
    link: "https://letterboxd.com/aditrigadigi/film/knives-out-2019/",
    imageUrl: "https://a.ltrbxd.com/resized/film-poster/4/7/5/3/7/0/475370-knives-out-0-2000-0-3000-crop.jpg?v=7da76d742c",
    isFavorite: true
  },
  {
    title: "Obsession",
    creatorOrLocation: "2025",
    ratingValue: 5,
    ratingDisplay: "★★★★★",
    link: "https://letterboxd.com/aditrigadigi/film/obsession-2025/",
    imageUrl: "https://a.ltrbxd.com/resized/film-poster/1/2/3/4/4/7/2/1234472-obsession-2025-2-0-2000-0-3000-crop.jpg?v=cff6fc00b6",
    isFavorite: true
  }
];

function extractPosterFromHtml(html: string): string | undefined {
  if (!html) return undefined;
  const match = html.match(/<img[^>]+src="([^">]+)"/i);
  return match ? match[1] : undefined;
}

// ==========================================
// 2. GOODREADS FETCH (STRICT 5-STAR ONLY)
// ==========================================
let allBooks: ShelfEntry[] = [];

try {
  // Read shelf
  const grReadRes = await fetch(
    `https://www.goodreads.com/review/list_rss/${GOODREADS_USER_ID}?shelf=read&t=${Date.now()}`,
    { headers: { 'User-Agent': 'Mozilla/5.0' } }
  );
  if (grReadRes.ok) {
    const xml = await grReadRes.text();
    const parser = new XMLParser({ ignoreAttributes: false });
    const parsed = parser.parse(xml);
    const items = parsed?.rss?.channel?.item;

    if (items) {
      const feedItems = Array.isArray(items) ? items : [items];
      allBooks = feedItems.map((item: any) => {
        const score = parseInt(item.user_rating, 10) || 0;
        return {
          title: item.title || "Untitled",
          creatorOrLocation: item.author_name ? `by ${item.author_name}` : undefined,
          ratingValue: score,
          ratingDisplay: score > 0 ? "★".repeat(score) : "Read",
          link: item.link || `https://www.goodreads.com/user/show/${GOODREADS_USER_ID}`,
          imageUrl: item.book_large_image_url || item.book_image_url || extractPosterFromHtml(item.description || ""),
          pubDate: item.pubDate ? new Date(item.pubDate) : new Date(0)
        };
      });
    }
  }
} catch (e) {
  console.warn("Could not load Goodreads feed.", e);
}

// Only keep 5-star books (up to 4)
const topBooks = allBooks
  .filter((b) => b.ratingValue === 5)
  .slice(0, 4);

// ==========================================
// 3. RESTAURANTS & MUSIC (shelf.json)
// ==========================================
const sortedRestaurants = [...(shelfData.restaurants || [])].sort((a, b) => b.rating - a.rating);
const topRestaurants = sortedRestaurants.slice(0, 4);

const favoriteMusic = (shelfData as any).music || [
  { album: "Alvvays", artist: "Alvvays", year: "2014", link: "https://open.spotify.com/album/1K6TvnkvmnLKPhifmPb6N7?si=d5C4xduQQWaFzZXNNLrMLQ", imageUrl: "https://upload.wikimedia.org/wikipedia/en/5/5e/Alvvays_2014.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail_unscaled" },
  { album: "Songs of Her's", artist: "Her's", year: "2017", link: "https://open.spotify.com/album/03gwRG5IvkStFnjPmgjElw?si=r7G8UT75QqaNAIXWMAc8Yw", imageUrl: "https://upload.wikimedia.org/wikipedia/en/1/15/SongsOfHers.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail_unscaled" },
  { album: "Melophobia", artist: "Cage the Elephant", year: "2017", link: "https://open.spotify.com/album/4EK8gtQfdVsmDTji7gBFlz?si=4ypHCztHQhGWSYw_JfBCCg", imageUrl: "https://upload.wikimedia.org/wikipedia/en/1/1e/Cage_the_Elephant_Melophobia.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail_unscaled" },
  { album: "Gana Sagaram (Live at Sri Krishna Gana Sabha, August - 1984)", artist: " Lalgudi G. Jayaraman, Lalgudi G.J.R. Krishnan, Trichy Sankaran", year: "2018", link: "https://open.spotify.com/album/7KFHoMwR6cytZbF8ewoYFP?si=PanU_5bRTce7VH5g4zZJpQ", imageUrl: "https://c.saavncdn.com/370/Gana-Sagaram-Live-at-Sri-Krishna-Gana-Sabha-August-1984--Tamil-2018-20180821224829-500x500.jpg" }
];
---

<BaseLayout title="Random" description="random things.">
  <!-- Page Header -->
  <section class="mb-12">
    <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-primary mb-3">
      Random
    </h1>
    <p class="font-serif italic text-muted text-base leading-relaxed mb-2">
      Some things I like to track for myself. My favorites (01), city bucket lists (02), and other things (03).
      <a href="#fn-1" class="text-accent font-mono text-[11px] hover:underline"> [1]</a>
    </p>

    <!-- Outward Platform Links -->
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs">
      <a 
        href={`https://www.goodreads.com/user/show/${GOODREADS_USER_ID}`}
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-accent hover:underline hover:text-[#B4383B] active:text-[#7A1E20] transition-colors duration-200"
      >
        goodreads ↗
      </a>
      <span class="text-muted/40">|</span>
      <a 
        href={`https://letterboxd.com/${LETTERBOXD_USER}`}
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-accent hover:underline hover:text-[#B4383B] active:text-[#7A1E20] transition-colors duration-200"
      >
        letterboxd ↗
      </a>
      <span class="text-muted/40">|</span>
      <a 
        href="https://beliapp.co" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-accent hover:underline hover:text-[#B4383B] active:text-[#7A1E20] transition-colors duration-200"
      >
        beli ↗
      </a>
      <span class="text-muted/40">|</span>
      <a 
        href="https://open.spotify.com/user/uos4rs1df4gkyihyfn4f6pl5x?si=4a61bbf99d2b4585" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-accent hover:underline hover:text-[#B4383B] active:text-[#7A1E20] transition-colors duration-200"
      >
        spotify ↗
      </a>
    </div>
  </section>

  <div class="space-y-16">

    <!-- ==========================================
         SECTION 01: FAVORITES (TIGHTER SUBSECTIONS)
         ========================================== -->
    <section class="space-y-6">
      <div class="flex items-baseline space-x-2 border-b border-surface pb-3">
        <h2 class="font-serif text-2xl font-semibold text-primary">Favorites</h2>
        <span class="text-accent font-mono text-sm">/ 01</span>
      </div>

      <!-- Subsection 1.1: Books -->
      <div class="space-y-1.5">
        <div class="flex items-baseline space-x-1.5 px-2">
          <span class="font-mono text-xs text-accent">/</span>
          <h3 class="font-mono text-[11px] uppercase tracking-wider text-muted font-medium">books</h3>
        </div>

        <div>
          <div class="flex items-end justify-start gap-4 sm:gap-6 overflow-x-auto pb-0 px-2 select-none scrollbar-none">
            {topBooks.map((book, idx) => (
              <a 
                href={book.link} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="group relative flex-shrink-0 transition-all duration-300 hover:-translate-y-2.5 focus:outline-none"
              >
                <div class="relative w-28 sm:w-32 h-44 sm:h-48 bg-[#EDE7DF] rounded-[2px] shadow-sm group-hover:shadow-md border border-[#D5CCC0] overflow-hidden transition-shadow">
                  <div class="absolute inset-y-0 left-0 w-2.5 bg-gradient-to-r from-black/15 via-black/5 to-transparent z-10 pointer-events-none"></div>
                  {book.imageUrl ? (
                    <img src={book.imageUrl} alt={book.title} class="w-full h-full object-cover" loading="lazy" />
                  ) : (
                    <div class="p-3 h-full flex flex-col justify-between font-serif">
                      <span class="text-[9px] font-mono text-accent">#{idx + 1}</span>
                      <p class="text-[11px] leading-tight text-primary font-medium line-clamp-3">{book.title}</p>
                      <span class="text-[9px] font-mono text-muted">{book.ratingDisplay}</span>
                    </div>
                  )}
                  <!-- Hover Details -->
                  <div class="absolute inset-0 bg-[#2B2826]/90 text-[#FAF8F5] p-3 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between z-20 pointer-events-none">
                    <span class="font-mono text-[8px] text-accent uppercase tracking-widest">Selected #{idx + 1}</span>
                    <p class="font-serif text-xs font-medium leading-snug line-clamp-3">{book.title}</p>
                    <div class="flex items-baseline justify-between font-mono text-[9px]">
                      <span class="text-[#FAF8F5]/80 line-clamp-1">{book.creatorOrLocation}</span>
                      <span class="text-accent">{book.ratingDisplay}</span>
                    </div>
                  </div>
                </div>
                <span class="block text-center font-mono text-[9px] text-muted group-hover:text-accent group-hover:text-[#B4383B] transition-colors mt-2">
                  0{idx + 1}
                </span>
              </a>
            ))}
          </div>
          <div class="h-1.5 bg-[#DDD5CA] border-t border-b border-[#CBC1B4] rounded-[1px] mt-2"></div>
          <div class="h-3 bg-gradient-to-b from-[#DDD5CA]/40 to-transparent"></div>
        </div>
      </div>

      <!-- Subsection 1.2: Movies -->
      <div class="space-y-1.5">
        <div class="flex items-baseline space-x-1.5 px-2">
          <span class="font-mono text-xs text-accent">/</span>
          <h3 class="font-mono text-[11px] uppercase tracking-wider text-muted font-medium">movies</h3>
        </div>

        <div>
          <div class="flex items-end justify-start gap-4 sm:gap-6 overflow-x-auto pb-0 px-2 select-none scrollbar-none">
            {topFilms.map((film, idx) => (
              <a 
                href={film.link} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="group relative flex-shrink-0 transition-all duration-300 hover:-translate-y-2.5 focus:outline-none"
              >
                <div class="relative w-28 sm:w-32 h-44 sm:h-48 bg-[#EDE7DF] rounded-[2px] shadow-sm group-hover:shadow-md border border-[#D5CCC0] overflow-hidden transition-shadow">
                  {film.imageUrl ? (
                    <img src={film.imageUrl} alt={film.title} class="w-full h-full object-cover" loading="lazy" />
                  ) : (
                    <div class="p-3 h-full flex flex-col justify-between font-serif">
                      <span class="text-[9px] font-mono text-accent">#{idx + 1}</span>
                      <p class="text-[11px] leading-tight text-primary font-medium line-clamp-3">{film.title}</p>
                      <span class="text-[9px] font-mono text-muted">{film.ratingDisplay}</span>
                    </div>
                  )}
                  <!-- Hover Details -->
                  <div class="absolute inset-0 bg-[#2B2826]/90 text-[#FAF8F5] p-3 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between z-20 pointer-events-none">
                    <span class="font-mono text-[8px] text-accent uppercase tracking-widest">Favorite #{idx + 1}</span>
                    <p class="font-serif text-xs font-medium leading-snug line-clamp-3">{film.title}</p>
                    <div class="flex items-baseline justify-between font-mono text-[9px]">
                      <span class="text-[#FAF8F5]/80">{film.creatorOrLocation || "Film"}</span>
                      <span class="text-accent">{film.ratingDisplay}</span>
                    </div>
                  </div>
                </div>
                <span class="block text-center font-mono text-[9px] text-muted group-hover:text-accent group-hover:text-[#B4383B] transition-colors mt-2">
                  0{idx + 1}
                </span>
              </a>
            ))}
          </div>
          <div class="h-1.5 bg-[#DDD5CA] border-t border-b border-[#CBC1B4] rounded-[1px] mt-2"></div>
          <div class="h-3 bg-gradient-to-b from-[#DDD5CA]/40 to-transparent"></div>
        </div>
      </div>

      <!-- Subsection 1.3: Music -->
      <div class="space-y-1.5">
        <div class="flex items-baseline space-x-1.5 px-2">
          <span class="font-mono text-xs text-accent">/</span>
          <h3 class="font-mono text-[11px] uppercase tracking-wider text-muted font-medium">music</h3>
        </div>

        <div>
          <div class="flex items-end justify-start gap-4 sm:gap-6 overflow-x-auto pb-0 px-2 select-none scrollbar-none">
            {favoriteMusic.map((album: any, idx: number) => (
              <a 
                href={album.link} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="group relative flex-shrink-0 transition-all duration-300 hover:-translate-y-2.5 focus:outline-none"
              >
                <!-- Vinyl Sleeve -->
                <div class="relative w-32 sm:w-36 h-32 sm:h-36 bg-[#EDE7DF] rounded-[2px] shadow-sm group-hover:shadow-md border border-[#D5CCC0] overflow-hidden transition-shadow">
                  {album.imageUrl ? (
                    <img src={album.imageUrl} alt={album.album} class="w-full h-full object-cover" loading="lazy" />
                  ) : (
                    <div class="p-3 h-full flex flex-col justify-between font-serif">
                      <span class="text-[9px] font-mono text-accent">0{idx + 1}</span>
                      <p class="text-[11px] leading-tight text-primary font-medium line-clamp-2">{album.album}</p>
                      <span class="text-[9px] font-mono text-muted">{album.artist}</span>
                    </div>
                  )}
                  <!-- Hover Details -->
                  <div class="absolute inset-0 bg-[#2B2826]/90 text-[#FAF8F5] p-3 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between z-20 pointer-events-none">
                    <span class="font-mono text-[8px] text-accent uppercase tracking-widest">Album #{idx + 1}</span>
                    <div>
                      <p class="font-serif text-xs font-medium leading-snug line-clamp-2">{album.album}</p>
                      <p class="font-mono text-[9px] text-[#FAF8F5]/80 mt-0.5">{album.artist}</p>
                    </div>
                    <span class="font-mono text-[9px] text-accent">{album.year}</span>
                  </div>
                </div>
                <span class="block text-center font-mono text-[9px] text-muted group-hover:text-accent group-hover:text-[#B4383B] transition-colors mt-2">
                  0{idx + 1}
                </span>
              </a>
            ))}
          </div>
          <div class="h-1.5 bg-[#DDD5CA] border-t border-b border-[#CBC1B4] rounded-[1px] mt-2"></div>
          <div class="h-3 bg-gradient-to-b from-[#DDD5CA]/40 to-transparent"></div>
        </div>
      </div>

      <!-- Subsection 1.4: Food -->
      <div class="space-y-1.5">
        <div class="flex items-baseline space-x-1.5 px-2">
          <span class="font-mono text-xs text-accent">/</span>
          <h3 class="font-mono text-[11px] uppercase tracking-wider text-muted font-medium">food</h3>
          <a href="#fn-2" class="text-accent font-mono text-[10px] hover:underline">[2]</a>
        </div>

        <div>
          <div class="flex items-end justify-start gap-4 sm:gap-6 overflow-x-auto pb-0 px-2 select-none scrollbar-none">
            {topRestaurants.map((spot, idx) => (
              <div 
                class="group relative flex-shrink-0 transition-all duration-300 hover:-translate-y-2.5 cursor-default"
              >
                <div class="w-24 sm:w-28 h-36 sm:h-40 bg-[#FAF8F5] border border-[#D5CCC0] rounded-[2px] p-3 flex flex-col justify-between shadow-sm group-hover:shadow-md transition-shadow relative">
                  <div class="border-b border-dashed border-[#D5CCC0]/80 pb-1 flex items-center justify-between">
                    <span class="font-mono text-[8px] text-accent font-semibold uppercase tracking-wider">{spot.city}</span>
                    <span class="font-mono text-[8px] text-muted">no. 0{idx + 1}</span>
                  </div>
                  <p class="font-serif text-xs font-semibold text-primary leading-tight line-clamp-3 my-auto">
                    {spot.name}
                  </p>
                  <div class="border-t border-[#D5CCC0]/60 pt-1 flex items-baseline justify-between">
                    <span class="font-mono text-[8px] text-muted line-clamp-1">{spot.tag}</span>
                    <span class="font-mono text-[9px] font-semibold text-accent">{spot.rating}</span>
                  </div>

                  <div class="absolute inset-0 bg-[#2B2826]/90 text-[#FAF8F5] p-3 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between z-20 pointer-events-none rounded-[2px]">
                    <span class="font-mono text-[8px] text-accent uppercase tracking-widest">{spot.city} · {spot.tag}</span>
                    <p class="font-serif text-xs font-medium leading-snug">{spot.name}</p>
                    <div class="font-mono text-[9px] text-accent font-semibold text-right">
                      Score: {spot.rating} / 10
                    </div>
                  </div>
                </div>
                <span class="block text-center font-mono text-[9px] text-muted group-hover:text-accent group-hover:text-[#B4383B] transition-colors mt-2">
                  0{idx + 1}
                </span>
              </div>
            ))}
          </div>
          <div class="h-1.5 bg-[#DDD5CA] border-t border-b border-[#CBC1B4] rounded-[1px] mt-2"></div>
          <div class="h-3 bg-gradient-to-b from-[#DDD5CA]/40 to-transparent"></div>
        </div>
      </div>

    </section>

    <!-- ==========================================
         SECTION 02: PLACES & BUCKET LISTS
         ========================================== -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-surface pb-3">
        <div class="flex items-baseline space-x-2">
          <h2 class="font-serif text-2xl font-semibold text-primary">Places</h2>
          <span class="text-accent font-mono text-sm">/ 02   (and bucket lists)</span>
        </div>
      </div>

      <!-- Luggage Tag Accordion Stack -->
      <div class="divide-y divide-[#E2DBD1] border-y border-[#E2DBD1]">
        {travelData.map((place: any, idx: number) => {
          const completedCount = place.items?.filter((i: any) => i.done).length || 0;
          const totalCount = place.items?.length || 0;
          
          return (
            <details class="group py-3.5 transition-colors duration-200">
              <summary class="flex items-center justify-between cursor-pointer list-none select-none group-hover:text-accent">
                <div class="flex items-baseline space-x-3 sm:space-x-5">
                  <span class="font-mono text-[11px] font-semibold text-accent/80 tracking-wider w-8">
                    {place.code || `0${idx + 1}`}
                  </span>

                  <div class="flex items-baseline space-x-2">
                    <h3 class="font-serif text-base font-semibold text-primary group-hover:text-accent group-hover:text-[#B4383B] transition-colors">
                      {place.city}
                    </h3>
                    <span class="font-serif italic text-xs text-muted">
                      {place.country}
                    </span>
                  </div>
                </div>

                <div class="flex items-center space-x-3 sm:space-x-6 font-mono text-xs text-muted">
                  <span class="hidden sm:inline-block text-[11px]">
                    {place.year}
                  </span>
                  
                  {totalCount > 0 && (
                    <span class="text-[10px] bg-surface/40 px-1.5 py-0.5 rounded-[2px] border border-surface/70">
                      {completedCount}/{totalCount}
                    </span>
                  )}

                  <span class="text-accent font-mono text-xs group-open:rotate-45 transition-transform duration-200 inline-block">
                    +
                  </span>
                </div>
              </summary>

              <div class="mt-4 pt-3 pb-2 pl-4 sm:pl-11 border-l-2 border-dashed border-[#DDD5CA] space-y-3">
                <div class="space-y-1.5 font-mono text-xs">
                  {place.items?.map((item: any) => (
                    <div class="flex items-start space-x-2.5">
                      {item.done ? (
                        <span class="text-accent font-bold select-none">[x]</span>
                      ) : (
                        <span class="text-muted/60 select-none">[ ]</span>
                      )}
                      <span class={item.done ? "text-primary/90" : "text-muted italic"}>
                        {item.text}
                      </span>
                    </div>
                  ))}
                </div>

              </div>
            </details>
          );
        })}
      </div>
    </section>

    <!-- ==========================================
         SECTION 03: Others
         ========================================== -->
    <section class="space-y-4">
      <div class="flex items-baseline justify-between border-b border-surface pb-3">
        <div class="flex items-baseline space-x-2">
          <h2 class="font-serif text-2xl font-semibold text-primary">Others</h2>
          <span class="text-accent font-mono text-sm">/ 03</span>
        </div>
        <span class="font-mono text-[10px] text-muted uppercase tracking-wider"></span>
      </div>

      <!-- Minimal Scorecard Ledger -->
      <div class="divide-y divide-[#E2DBD1]/70 border-y border-[#E2DBD1] my-2">
        {(shelfData.games || []).map((game: any) => (
          <div class="py-2.5 flex items-baseline justify-between group hover:bg-surface/20 px-1 rounded-[2px] transition-colors">
            <!-- Game Title -->
            <div class="flex items-baseline space-x-2">
              <span class="font-serif text-sm font-medium text-primary group-hover:text-accent group-hover:text-[#B4383B] transition-colors">
                {game.name}
              </span>
              <span class="font-mono text-[10px] text-muted/70">daily</span>
            </div>

            <!-- Dotted Guide Line -->
            <div class="flex-grow mx-3 border-b border-dotted border-[#D5CCC0]/60 hidden sm:block"></div>

            <!-- Streak Counter & Record -->
            <div class="flex items-baseline space-x-2 font-mono text-xs shrink-0">
              <span class="font-semibold text-accent text-[#B4383B]">
                {game.streak} {game.streak === 1 ? 'day' : 'days'}
              </span>
              <span class="text-[10px] text-muted">
                (best: {game.best})
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FOOTNOTES -->
    <section class="pt-4 pb-2 border-t border-surface/70 text-xs font-sans text-muted flex items-start justify-between gap-4 -mb-10 sm:-mb-12">
      <!-- Footnote text column -->
      <div class="space-y-1.5 flex-1 min-w-0">
        <p id="fn-1">
          <span class="font-mono text-accent text-[11px] mr-1">[1]</span>
          <span class="italic">Favorites, foods, music, streaks are pulled from JSON files with exported Beli data and manual lists. Latest book and films from home page are pulled from Goodreads and Letterboxd RSS feeds.</span>
        </p>
        <p id="fn-2">
          <span class="font-mono text-accent text-[11px] mr-1">[2]</span>
          <span class="italic">Thanks Anushka for taking me to literally all of these</span>
        </p>
      </div>

      <!-- Goblin column -->
      <div class="shrink-0 select-none">
        <img 
          src="/images/goblin.png" 
          alt="goblin" 
          class="w-20 sm:w-20 h-auto opacity-80 hover:opacity-100 transition-opacity"
          loading="lazy"
        />
      </div>
    </section>
  </div>
</BaseLayout>
